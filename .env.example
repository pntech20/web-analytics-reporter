# Web Analytics Reporter

# Required when exposing an HTTP endpoint.
# Use a long random value. Vercel Cron and manual requests must send this secret.
CRON_SECRET=replace-with-a-long-random-secret

# Required. Numeric Google Analytics 4 property ID, not the measurement ID.
# Correct: 123456789
# Not this: G-XXXXXXXXXX
GA4_PROPERTY_ID=123456789

# Required. Google service account with Viewer access to the GA4 property.
GOOGLE_CLIENT_EMAIL=ga4-report-reader@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key\n-----END PRIVATE KEY-----\n"

# Required. Telegram bot destination.
TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
TELEGRAM_CHAT_ID=123456789

# Optional. Report display settings.
REPORT_SITE_ID=default
REPORT_SITE_NAME=Example Site
REPORT_TIME_ZONE=UTC

# Optional multi-site naming pattern.
# Use one GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY if that service account has Viewer access
# to every GA4 property listed below.
# MARKETING_GA4_PROPERTY_ID=111111111
# MARKETING_TELEGRAM_CHAT_ID=123456789
# DOCS_GA4_PROPERTY_ID=222222222
# DOCS_TELEGRAM_CHAT_ID=987654321
