{
  "name": "web-analytics-reporter",
  "version": "0.3.1",
  "description": "Composable website analytics reports for GA4, Telegram, and Node.js cron jobs.",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "web-analytics-reporter": "bin/web-analytics-reporter.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./browser": {
      "types": "./browser.d.ts",
      "require": "./browser.js",
      "default": "./browser.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "require": "./core.js",
      "default": "./core.js"
    },
    "./ga4": {
      "types": "./ga4.d.ts",
      "require": "./ga4.js",
      "default": "./ga4.js"
    },
    "./telegram": {
      "types": "./telegram.d.ts",
      "require": "./telegram.js",
      "default": "./telegram.js"
    },
    "./runner": {
      "types": "./runner.d.ts",
      "require": "./runner.js",
      "default": "./runner.js"
    },
    "./vercel": {
      "types": "./vercel.d.ts",
      "require": "./vercel.js",
      "default": "./vercel.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.js",
    "*.d.ts",
    ".env.example",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check *.js bin/*.js test/*.js examples/*/*.js examples/netlify/functions/*.js",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "analytics",
    "ga4",
    "google-analytics",
    "telegram",
    "reports",
    "cron",
    "serverless",
    "github-actions",
    "netlify",
    "express",
    "web-analytics",
    "vercel"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pntech20/web-analytics-reporter.git"
  },
  "bugs": {
    "url": "https://github.com/pntech20/web-analytics-reporter/issues"
  },
  "homepage": "https://analyticsreporter.xyz/",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
